{
  "info": {
    "name": "Collabspace API",
    "_postman_id": "c011ab59-ace0-4c11-b1e9-9011ab59ace0",
    "description": "Collabspace API - Enterprise Project Management, Kanban, Real-time WebSockets (Reverb), Meetings, AI Summaries & Platform Analytics",
