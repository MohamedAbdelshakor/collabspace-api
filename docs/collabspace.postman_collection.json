            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Mohamed Salah\",\n  \"email\": \"admin@example.com\",\n  \"password\": \"Password123!\",\n  \"password_confirmation\": \"Password123!\",\n  \"remember_me\": true\n}"
