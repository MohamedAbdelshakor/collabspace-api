        {
          "name": "Create Project",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"CollabSpace – Web Platform\",\n  \"description\": \"Comprehensive collaborative workspace API\",\n  \"type\": \"development\",\n  \"priority\": \"high\",\n  \"start_date\": \"2026-10-01\",\n  \"deadline\": \"2026-12-31\"\n}"
            },
            "url": { "raw": "{{base_url}}/projects", "host": ["{{base_url}}"], "path": ["projects"] }
          }
        },
        {
          "name": "List Project Tasks (Kanban)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/projects/01JM7P00000000000000000001/tasks", "host": ["{{base_url}}"], "path": ["projects", "01JM7P00000000000000000001", "tasks"] }
          }
        },
        {
          "name": "Create Task",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
